@model List<Order>
@{
    ViewData["Title"] = "My Orders";
    var current = ViewData["Status"] as string ?? "All";
    var statuses = new[] { "All", "Pending", "Shipped", "Cancelled" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="mb-0"><i class="bi bi-receipt"></i> My orders</h2>
    <a class="btn btn-success" asp-action="Create"><i class="bi bi-cart-plus"></i> Place order</a>
</div>

<ul class="nav nav-pills mb-3">
    @foreach (var s in statuses)
    {
        <li class="nav-item">
            <a class="nav-link @(s == current ? "active" : "")" asp-action="Index" asp-route-status="@s">@s</a>
        </li>
    }
</ul>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th class="text-end">Items</th>
                    <th class="text-end">Total (VND)</th>
                    <th>Status</th>
                    <th class="text-end">Invoice</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.OrderID</td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">@o.OrderDetails.Count</td>
                    <td class="text-end">@o.OrderDetails.Sum(d => d.LineTotal).ToString("N0")</td>
                    <td><partial name="_StatusBadge" model="o.OrderStatus" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Invoice" asp-route-id="@o.OrderID" target="_blank" rel="noopener">
                            <i class="bi bi-printer"></i> Print invoice
                        </a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No orders to show.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
