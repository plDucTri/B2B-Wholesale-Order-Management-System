@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center mt-5">
    <h2><i class="bi bi-slash-circle text-danger"></i> Access denied</h2>
    <p class="text-muted">This portal is for Agent accounts only.</p>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button class="btn btn-primary" type="submit">Sign in with another account</button>
    </form>
</div>
