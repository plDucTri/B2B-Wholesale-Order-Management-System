@model OrderFormViewModel
@{
    ViewData["Title"] = "Place order";
}

<h2 class="mb-1"><i class="bi bi-cart-plus"></i> Place a bulk order</h2>
<p class="text-muted">Enter a quantity for each item you want. Items left at 0 are not ordered.</p>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <strong><i class="bi bi-exclamation-triangle"></i> Your order was not placed:</strong>
        <ul class="mb-0">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post">
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Size</th>
                        <th class="text-end">Unit price (VND)</th>
                        <th class="text-end">In stock</th>
                        <th style="width:150px">Quantity</th>
                        <th class="text-end">Line total (VND)</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var l = Model.Lines[i];
                    <tr>
                        <td>
                            @l.ItemName
                            <input type="hidden" name="lines[@(i)].ItemId" value="@l.ItemId" />
                        </td>
                        <td>@l.Size</td>
                        <td class="text-end">@l.Price.ToString("N0")</td>
                        <td class="text-end">@l.Stock</td>
                        <td>
                            <input type="number" class="form-control form-control-sm qty"
                                   name="lines[@(i)].Quantity" value="@l.Quantity" min="0" max="@l.Stock"
                                   data-price="@(l.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                   @(l.Stock == 0 ? "disabled" : "") />
                        </td>
                        <td class="text-end line-total">-</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <th colspan="5" class="text-end">Order total</th>
                        <th class="text-end" id="grand">0 VND</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-controller="Catalog" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> Place order</button>
    </div>
</form>

@section Scripts {
    <script>
        const fmt = new Intl.NumberFormat('en-US');
        function recalc() {
            let total = 0;
            document.querySelectorAll('tbody tr').forEach(tr => {
                const q = tr.querySelector('.qty');
                if (!q) return;
                const qty = Math.max(0, parseInt(q.value, 10) || 0);
                const line = qty * parseFloat(q.dataset.price);
                tr.querySelector('.line-total').textContent = qty > 0 ? fmt.format(line) : '-';
                tr.classList.toggle('table-primary', qty > 0);
                total += line;
            });
            document.getElementById('grand').textContent = fmt.format(total) + ' VND';
        }
        document.querySelectorAll('.qty').forEach(q => q.addEventListener('input', recalc));
        recalc();
    </script>
}
