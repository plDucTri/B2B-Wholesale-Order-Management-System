@model Order
@{
    ViewData["Title"] = $"Order #{Model.OrderID}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-receipt"></i> Order #@Model.OrderID</h2>
    <span class="badge text-bg-warning fs-6">@Model.OrderStatus</span>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4"><strong>Agent:</strong> @Model.Agent?.AgentName</div>
            <div class="col-md-4"><strong>Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-md-4"><strong>Status:</strong> @Model.OrderStatus</div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Size</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit price (VND)</th>
                    <th class="text-end">Subtotal (VND)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>@d.Item?.ItemName</td>
                    <td>@d.Item?.Size</td>
                    <td class="text-end">@d.Quantity</td>
                    <td class="text-end">@d.UnitAmount.ToString("N0")</td>
                    <td class="text-end">@d.LineTotal.ToString("N0")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <th colspan="4" class="text-end">Total</th>
                    <th class="text-end">@Model.OrderDetails.Sum(d => d.LineTotal).ToString("N0")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid"></i> Back to catalog</a>
    <a class="btn btn-outline-success" asp-action="Create"><i class="bi bi-cart-plus"></i> Place another order</a>
</div>
